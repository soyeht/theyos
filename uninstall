#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
AUTO_YES=false
DRY_RUN=false
KEEP_DATA=false
FAILURES=()

usage() {
    cat <<'EOF'
Usage: ./uninstall [--yes] [--dry-run] [--keep-data]

Removes a source checkout install created by ./install on macOS or Linux:
PATH symlinks, local services, runtime files, generated secrets, logs, and
VM/customer data unless --keep-data is passed. NixOS deployments still use
./uninstall-nixos because they modify system configuration declaratively.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --yes|-y) AUTO_YES=true ;;
        --dry-run) DRY_RUN=true ;;
        --keep-data) KEEP_DATA=true ;;
        --help|-h) usage; exit 0 ;;
        *) printf '[error] unknown argument: %s\n' "$1" >&2; usage; exit 2 ;;
    esac
    shift
done

log() { printf '[uninstall] %s\n' "$*"; }
warn() { printf '[warn] %s\n' "$*" >&2; }

quote_cmd() {
    local out=()
    local arg
    for arg in "$@"; do
        printf -v arg '%q' "$arg"
        out+=("$arg")
    done
    printf '%s' "${out[*]}"
}

run_cmd() {
    if [ "$DRY_RUN" = true ]; then
        printf '[dry-run] %s\n' "$(quote_cmd "$@")"
        return 0
    fi
    "$@"
}

can_sudo() {
    command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1
}

confirm() {
    [ "$AUTO_YES" = true ] && return 0
    [ "$DRY_RUN" = true ] && return 0
    printf 'This will remove the theyOS source install. Type "uninstall" to continue: '
    read -r answer
    [ "$answer" = "uninstall" ] || { echo "Aborted."; exit 1; }
}

remove_path() {
    local path="$1"
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        return 0
    fi
    if [ "$DRY_RUN" = true ]; then
        run_cmd rm -rf "$path"
        return 0
    fi
    if run_cmd rm -rf "$path"; then
        log "removed $path"
    elif can_sudo && run_cmd sudo rm -rf "$path"; then
        log "removed $path with sudo"
    else
        warn "could not remove $path"
        FAILURES+=("$path")
    fi
}

secure_remove_file() {
    local path="$1"
    [ -f "$path" ] || return 0
    if command -v shred >/dev/null 2>&1 && [ "$(uname -s)" != "Darwin" ]; then
        if run_cmd shred -u "$path"; then
            log "securely removed $path"
        else
            warn "could not shred $path; falling back to rm"
            remove_path "$path"
        fi
    else
        remove_path "$path"
    fi
}

remove_symlink_into_repo() {
    local path="$1"
    [ -L "$path" ] || return 0
    local target
    target="$(readlink "$path" 2>/dev/null || true)"
    case "$target" in
        "$REPO_DIR"/*) remove_path "$path" ;;
    esac
}

launchctl_stop() {
    local label="$1"
    local uid
    uid="$(id -u)"
    run_cmd /bin/launchctl bootout "gui/$uid/$label" 2>/dev/null || true
    run_cmd /bin/launchctl remove "$label" 2>/dev/null || true
}

stop_services() {
    if [ -x "$HOME/.local/bin/soyeht" ]; then
        run_cmd "$HOME/.local/bin/soyeht" admin-host-stop 2>/dev/null || true
        run_cmd "$HOME/.local/bin/soyeht" caddy stop 2>/dev/null || true
        run_cmd "$HOME/.local/bin/soyeht" cloudflared stop 2>/dev/null || true
    fi

    if [ "$(uname -s)" = "Darwin" ]; then
        launchctl_stop com.soyeht.caddy
        launchctl_stop com.theyos.cloudflared
    elif command -v systemctl >/dev/null 2>&1; then
        run_cmd systemctl --user disable --now soyeht-engine.service 2>/dev/null || true
        run_cmd systemctl --user stop soyeht-engine.service 2>/dev/null || true
        run_cmd systemctl --user daemon-reload 2>/dev/null || true
    fi

    if [ -f "$REPO_DIR/.run/soyeht-admin-host.pid" ]; then
        local pid
        pid="$(cat "$REPO_DIR/.run/soyeht-admin-host.pid" 2>/dev/null || true)"
        if [[ "$pid" =~ ^[0-9]+$ ]]; then
            run_cmd kill "$pid" 2>/dev/null || true
        fi
    fi
}

remove_files() {
    remove_symlink_into_repo "$HOME/.local/bin/soyeht"
    remove_symlink_into_repo "$HOME/.local/bin/theyos"
    remove_symlink_into_repo "$HOME/.local/bin/init_macos_guest"

    secure_remove_file "$REPO_DIR/.env"
    remove_path "$REPO_DIR/.run"
    remove_path "$REPO_DIR/logs"
    remove_path "$REPO_DIR/cloudflared"
    remove_path "$REPO_DIR/distro/cloudflared/config.yml"
    remove_path "$REPO_DIR/.caddy.env"

    if [ "$(uname -s)" = "Darwin" ]; then
        remove_path "$HOME/Library/LaunchAgents/com.soyeht.caddy.plist"
        remove_path "$HOME/Library/LaunchAgents/com.theyos.cloudflared.plist"
        remove_path "$HOME/Library/Logs/theyos"
        remove_path "$HOME/Library/Caches/theyos"
        remove_path "${XDG_CACHE_HOME:-$HOME/.cache}/theyos"
        [ "$KEEP_DATA" = true ] || remove_path "$HOME/Library/Application Support/theyos"
    else
        remove_path "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/soyeht-engine.service"
        [ "$KEEP_DATA" = true ] || remove_path "$HOME/.local/share/Soyeht"
    fi

    if [ "$KEEP_DATA" = false ]; then
        remove_path "$REPO_DIR/claws/data"
        remove_path "$REPO_DIR/firecracker/golden-build"
        remove_path "$HOME/firecracker"
        remove_path "$HOME/.theyos"
    fi
}

verify_no_residuals() {
    local residuals=()
    for path in "$HOME/.local/bin/soyeht" "$HOME/.local/bin/theyos" "$HOME/.local/bin/init_macos_guest"; do
        if [ -L "$path" ]; then
            local target
            target="$(readlink "$path" 2>/dev/null || true)"
            case "$target" in "$REPO_DIR"/*) residuals+=("$path") ;; esac
        fi
    done

    for path in "$REPO_DIR/.env" "$REPO_DIR/.run" "$REPO_DIR/logs" "$REPO_DIR/cloudflared"; do
        [ -e "$path" ] || [ -L "$path" ] && residuals+=("$path")
    done

    if [ "$KEEP_DATA" = false ]; then
        for path in "$REPO_DIR/claws/data" "$HOME/firecracker" "$HOME/.theyos"; do
            [ -e "$path" ] || [ -L "$path" ] && residuals+=("$path")
        done
    fi

    if [ "$(uname -s)" = "Darwin" ]; then
        for path in "$HOME/Library/LaunchAgents/com.soyeht.caddy.plist" "$HOME/Library/LaunchAgents/com.theyos.cloudflared.plist" "$HOME/Library/Caches/theyos" "${XDG_CACHE_HOME:-$HOME/.cache}/theyos"; do
            [ -e "$path" ] || [ -L "$path" ] && residuals+=("$path")
        done
    elif [ "$KEEP_DATA" = false ]; then
        for path in "$HOME/.local/share/Soyeht" "${XDG_DATA_HOME:-$HOME/.local/share}/theyos" "${XDG_CONFIG_HOME:-$HOME/.config}/theyos" "${XDG_CACHE_HOME:-$HOME/.cache}/theyos" "${XDG_STATE_HOME:-$HOME/.local/state}/theyos"; do
            [ -e "$path" ] || [ -L "$path" ] && residuals+=("$path")
        done
    fi

    if [ "${#FAILURES[@]}" -gt 0 ] || [ "${#residuals[@]}" -gt 0 ]; then
        printf '[error] residual theyOS artifacts remain:\n' >&2
        printf '  %s\n' "${FAILURES[@]}" "${residuals[@]}" >&2
        return 1
    fi
    log "verification passed: no known source-install artifacts remain"
}

main() {
    confirm
    stop_services
    remove_files
    [ "$DRY_RUN" = true ] || verify_no_residuals
    log "done"
}

main "$@"
