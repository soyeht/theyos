# Environment and secrets
.env
.env.prod
.env.local
.caddy.env
bootstrap-token
*.token
*.json.bak

# Cloudflare credentials
distro/cloudflared/*.json
distro/cloudflared/config.yml

# Runtime data (DB, logs, PID, job queue — machine-specific, never committed)
.run/
admin/.dev.pids

# Data directories (not in repo)
datasets/
customers/
logs/

# Claw source repos (external git repos, managed separately)
claws/src/
claws/data/
claws/catalog.json

# Firecracker runtime state (golden builds, instances, snapshots, sockets, logs)
firecracker/

# MemOS source (external git repo, ~1GB)
memory/memos/

# Build artifacts
.deploy-staging/
dist/
build/
node_modules/
*.log
*.tmp
*.swp
.env*

# claws-verify / claws-discover transient outputs — regenerated by the tools,
# never meant to be committed.  Traceability lives in manifest.yml (reviewed_by
# + reviewed_at) + git history, not in these markdown snapshots.
artifacts/discover/
artifacts/verify/
admin/rust/store.db
admin/rust/instances.db
admin/frontend/node_modules/
admin/frontend/dist/
admin/web/
admin/rust/target/
debug/
release/
*.rs.bk
*.rlib
*.prof*
admin/rust/core-rs/src/generated_manifest.rs
*.tsbuildinfo
*.pyc
__pycache__/
.venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.opencode/

# AI agent config (machine-specific)
AGENTS.md
CLAUDE.md
.agents/
.claude/
.specify/

# Backups
*-backups/

# Test artifacts
test-reports/
.pytest_cache/
QA/runs/**/screenshots/*.png
artifacts/qa/screenshots/

# Streamlit
.streamlit/secrets.toml

# Tailscale certs and per-host Caddy config (generated by setup.sh, never committed)
tailscale/

# NixOS config is machine-specific and private — use distro/nixos/configuration.nix.example as reference
distro/nixos/configuration.nix

# NixOS flake (machine-specific, generated by ./install-nixos)
nix/hardware-configuration.nix
nix/base-configuration.nix
nix/host.nix
result
flake.lock

# macOS Virtualization Framework (machine-specific runtime state)
Library/Application Support/theyos/snapshots/
Library/Caches/theyos/
Library/Logs/theyos/
*.dSYM/
*.profdata
*.profraw

# CD-209 test residue; a test writes this and never cleans it up
.cd209-testtmp/
