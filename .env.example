# theyOS Environment Configuration
# Copy this to .env and fill in your values.
#
# ── macOS quick start ────────────────────────────────────────────────────────
# The launcher (theyos-admin-host) auto-detects all binary paths and
# platform-specific defaults from the repo root. On macOS you only need:
#
#   SOYEHT_ADMIN_PASSWORD=your-password
#   THEYOS_SESSION_PEPPER=$(openssl rand -hex 32)
#
# Everything else below is optional overrides. Skip the Linux sections.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin credentials ────────────────────────────────────────────────────────
SOYEHT_ADMIN_USER=admin
SOYEHT_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Session ──────────────────────────────────────────────────────────────────
# Rotate this when deploying to a new environment; changing it invalidates
# all existing sessions.
THEYOS_SESSION_PEPPER=GENERATE_WITH_openssl_rand_-hex_32

# Session TTL in seconds (default: 2592000 = 30 days).
# Active sessions auto-extend via sliding window on each request.
THEYOS_SESSION_TTL_SECS=2592000

# ── Bootstrap token (server pairing) ────────────────────────────────────
# Path to the bootstrap token file used for install-time mobile app pairing.
# On NixOS this is auto-generated; on macOS generate manually:
#   openssl rand -base64 32 > /path/to/bootstrap-token
# THEYOS_BOOTSTRAP_TOKEN_PATH=/var/lib/theyos/secrets/bootstrap-token

# ── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Owner-auth v2 rollout ────────────────────────────────────────────────────
# Default-off. Leave as legacy until the reviewed flip is explicitly approved.
# The only activation value is reviewed-core-v2; typos fail safe to LegacyOnly.
# Rollback is env + backend restart/rebuild, with the v1/legacy path preserved.
# THEYOS_OWNER_AUTH_V2_ROLLOUT=legacy

# ── Ports ─────────────────────────────────────────────────────────────────────
# Override only if the defaults conflict with another service.
# ADMIN_PORT=8892

# ── macOS: VM images directory ───────────────────────────────────────────────
# Defaults to ~/Library/Application Support/theyos/vms — only override if
# you want to store VM images elsewhere.
# THEYOS_VM_ASSETS_DIR=/path/to/vms

# ── Terminal v2: conversation log directory ───────────────────────────────
# The backend persists every byte produced by each conversation's PTY to an
# append-only log file at <THEYOS_CONVERSATIONS_DIR>/<conv_id>.log.
# Conversations persist across backend restarts; only explicit user deletion
# (via the UI) removes history.
# Defaults (all user-writable, no root required):
#   Linux:  $THEYOS_HOME/theyos/.run/conversations  (same tree as sessions DB)
#   macOS:  ~/Library/Application Support/theyos/conversations
# THEYOS_CONVERSATIONS_DIR=/home/youruser/theyos/.run/conversations

# ── Terminal v2: conversation log size cap ────────────────────────────────
# Per-conversation log size cap in bytes. When a conversation's log would
# exceed this size, the backend closes the PTY session cleanly with a
# `CTL:log_full` marker on the WebSocket and stops writing. The user can
# delete the conversation (via the UI) to reclaim the space. Unparseable
# values fall back to the default with a warning. Default: 500 MiB
# (524288000 bytes).
# THEYOS_CONV_LOG_MAX_BYTES=524288000

# ── macOS: Guest VM warm pool ──────────────────────────────────────────────────
# Number of pre-booted macOS guest VMs kept ready for instant claw creation.
# Apple's virtualization license allows at most 2 simultaneous macOS guest VMs
# per host. With THEYOS_MACOS_WARM_POOL_SIZE=1 (default), one slot is pre-warmed
# and the second slot is available for user instances. Setting this to 0 disables
# the warm pool (cold boot from snapshot on every create, ~30s instead of <2s).
# Valid values: 0 or 1 (values >1 are clamped to 1 due to the 2-VM limit).
# THEYOS_MACOS_WARM_POOL_SIZE=1

# ═══════════════════════════════════════════════════════════════════════════════
# Linux / NixOS only — the launcher auto-detects these on macOS
# ═══════════════════════════════════════════════════════════════════════════════

THEYOS_HOME=/home/YOUR_USER
ACCESS_MODE=local   # local | tailscale | domain

# Base domain for public-domain access mode (Cloudflare Tunnel).
# REQUIRED when ACCESS_MODE=domain — no hardcoded default. The server and
# `soyeht health` both read this; without it, public URL checks are skipped.
# On NixOS this is usually set automatically from nix/host.nix.
# THEYOS_BASE_DOMAIN=yourdomain.com

# Caddy Admin API URL (used by network status checks)
CADDY_ADMIN_URL=http://127.0.0.1:2019

# Number of SSH connection attempts when waiting for a new VM to boot (default 20)
FIRECRACKER_SSH_WAIT_TRIES=30

# How often (in seconds) the admin panel refreshes available claw versions (default 3600)
THEYOS_VERSION_REFRESH_INTERVAL=3600

# PTY transport mode for Rust terminal adapter: poll (default) or stream
THEYOS_TERMINAL_TRANSPORT=poll

# ── Rust IPC Backends (Linux) ─────────────────────────────────────────────────
# On macOS: omit these — the launcher resolves them from target/debug/ or
# target/release/ relative to the repo root. Build with:
#   cd admin/rust && cargo build --release
#
# THEYOS_CLAW_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/claw_ipc
# THEYOS_STORE_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/store-ipc
# THEYOS_TERMINAL_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/terminal-ipc
# THEYOS_SESSION_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/session_ipc
# THEYOS_JOBS_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/jobs-ipc
# THEYOS_RATELIMIT_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/ratelimit-ipc
# THEYOS_BACKUP_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/backup_ipc
# THEYOS_VMRUNNER_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/vmrunner_ipc
# THEYOS_EXECUTOR_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/executor_ipc
# THEYOS_ORCHESTRATOR_RS_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/orchestrator-ipc
# FIRECRACKER_CTL=${THEYOS_HOME}/theyos/admin/rust/target/release/fc-ssh

# ── imagebuilder (used by install worker for build-from-plan claws) ──────────
# When a claw has `distribution: local` and an InstallerPlan (builtin or
# template), the install worker shells out to `imagebuilder build <claw>`
# to produce the golden rootfs locally. Override this if imagebuilder is
# not on PATH:
# THEYOS_IMAGEBUILDER_BIN=${THEYOS_HOME}/theyos/admin/rust/target/release/imagebuilder

# ═══════════════════════════════════════════════════════════════════════════════
# Optional integrations
# ═══════════════════════════════════════════════════════════════════════════════

# ── API Keys (passed to claw installer scripts) ─────────────────────────────
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# GitHub API token — required for `soyeht claws-detect` batches and claws-scan drift checks.
# Unauthenticated rate limit is 60 req/h; authenticated is 5000.
GITHUB_TOKEN=

# ── Cloudflare Tunnel (optional — for public domain access mode) ─────────────
# CF_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
# CF_ZONE_ID=YOUR_ZONE_ID_FOR_DOMAIN
# CF_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
# CF_TUNNEL_ID=YOUR_TUNNEL_ID
# CF_DOMAIN=yourdomain.com
