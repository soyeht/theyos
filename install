#!/bin/sh
set -e
REPO_DIR="$(cd "$(dirname "$0")" && pwd)"

# ── Flag parsing ─────────────────────────────────────────────────────────────
# --with-caddy : on macOS, install caddy via brew without prompting (CI/automation).
# --no-caddy   : on macOS, skip the caddy detect/install prompt entirely.
WITH_CADDY=0
NO_CADDY=0
for arg in "$@"; do
    case "$arg" in
        --with-caddy) WITH_CADDY=1 ;;
        --no-caddy)   NO_CADDY=1 ;;
        -h|--help)
            printf 'Usage: ./install [--with-caddy | --no-caddy]\n'
            printf '  --with-caddy  install caddy via Homebrew if missing (no prompt)\n'
            printf '  --no-caddy    skip the caddy detect/install step\n'
            exit 0
            ;;
    esac
done

printf '============================================\n'
printf ' theyOS installer\n'
printf '============================================\n\n'

# ── OS detection ─────────────────────────────────────────────────────────────

OS_ID="unknown"
case "$(uname -s)" in
    Darwin) OS_ID="macos" ;;
    Linux)
        if [ -f /etc/os-release ]; then
            OS_ID=$(. /etc/os-release && printf '%s' "$ID")
        fi
        ;;
esac
printf '[install] detected OS: %s\n' "$OS_ID"

# ── Dependency checks ────────────────────────────────────────────────────────

missing=""
warn=""

# Build dependencies (required)
command -v cargo >/dev/null 2>&1 || missing="$missing cargo(rust)"
command -v node  >/dev/null 2>&1 || missing="$missing node"
command -v npm   >/dev/null 2>&1 || missing="$missing npm"
command -v git   >/dev/null 2>&1 || missing="$missing git"

# Runtime dependencies
command -v curl  >/dev/null 2>&1 || missing="$missing curl"
command -v tar   >/dev/null 2>&1 || missing="$missing tar"
command -v ssh-keygen >/dev/null 2>&1 || missing="$missing openssh"

# KVM (Linux only)
if [ "$OS_ID" != "macos" ]; then
    if [ ! -r /dev/kvm ] || [ ! -w /dev/kvm ]; then
        warn="$warn /dev/kvm(not-accessible)"
    fi
fi

if [ -n "$missing" ]; then
    printf '\n[install] ERROR: missing required tools:%s\n\n' "$missing"
    case "$OS_ID" in
        nixos)
            printf 'NixOS: Add to environment.systemPackages in configuration.nix:\n'
            printf '  git slirp4netns sqlite cloudflared\n'
            printf 'Install Rust: curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh\n'
            printf 'Install Node.js: nix-env -iA nixos.nodejs_20\n'
            ;;
        ubuntu|debian)
            printf '%s: Install missing packages:\n' "$OS_ID"
            printf '  sudo apt install -y git curl openssh-client sqlite3\n'
            printf 'Install Rust: curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh\n'
            printf 'Install Node.js 20+: https://nodejs.org/en/download\n'
            ;;
        macos)
            printf 'macOS: Install missing tools:\n'
            printf '  xcode-select --install\n'
            printf '  brew install node\n'
            printf 'Install Rust: curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh\n'
            ;;
        *)
            printf 'Install Rust (rustup.rs), Node.js 20+, and OpenSSH, then re-run ./install\n'
            ;;
    esac
    exit 1
fi

if [ -n "$warn" ]; then
    printf '[install] warnings:%s\n' "$warn"
fi

# ── Caddy (macOS only) ───────────────────────────────────────────────────────
#
# On NixOS, Caddy is declared in nix/module.nix and installed by nixos-rebuild.
# On macOS, public claw sites and HTTPS need a Caddy reverse proxy. We detect
# an existing install (PATH, brew --prefix), and only offer to install via brew
# with explicit consent. `soyeht setup` later registers a per-user LaunchAgent
# pointing at the repo Caddyfile — never touches the user's existing Caddy
# config or brew services.
if [ "$OS_ID" = "macos" ] && [ "$NO_CADDY" -eq 0 ]; then
    caddy_path=""
    if command -v caddy >/dev/null 2>&1; then
        caddy_path=$(command -v caddy)
    elif command -v brew >/dev/null 2>&1; then
        brew_caddy_prefix=$(brew --prefix caddy 2>/dev/null || true)
        if [ -n "$brew_caddy_prefix" ] && [ -x "$brew_caddy_prefix/bin/caddy" ]; then
            caddy_path="$brew_caddy_prefix/bin/caddy"
        fi
    fi

    if [ -n "$caddy_path" ]; then
        caddy_version=$("$caddy_path" version 2>/dev/null | awk '{print $1}')
        printf '[install] caddy detected: %s (%s)\n' "$caddy_path" "$caddy_version"
    elif command -v brew >/dev/null 2>&1; then
        printf '\n[install] Caddy not found. theyOS uses Caddy as the reverse proxy for\n'
        printf '          public claw sites and HTTPS local (https://admin.localhost).\n'
        if [ "$WITH_CADDY" -eq 1 ]; then
            install_caddy=y
            printf '[install] --with-caddy specified — installing without prompt\n'
        else
            printf '[install] Install via "brew install caddy" now? [y/N] '
            read install_caddy
        fi
        if printf '%s' "$install_caddy" | grep -qi '^y'; then
            printf '[install] running: brew install caddy\n'
            if brew install caddy; then
                printf '[install] caddy installed via Homebrew\n'
            else
                printf '[install] WARNING: brew install caddy failed.\n'
                printf '[install]   You can install it manually later, then run: soyeht caddy install\n'
            fi
        else
            printf '[install] skipped. Public claw sites and HTTPS will be unavailable until\n'
            printf '[install]   you install caddy and run: soyeht caddy install\n'
        fi
    else
        printf '\n[install] caddy not found and Homebrew is not installed.\n'
        printf '[install]   Public claw sites and HTTPS need Caddy. Install one of:\n'
        printf '[install]     - Homebrew + caddy: https://brew.sh then "brew install caddy"\n'
        printf '[install]     - Direct download: https://caddyserver.com/download\n'
        printf '[install]   Then run: soyeht caddy install\n'
    fi
fi

# ── Build Rust workspace ─────────────────────────────────────────────────────

printf '\n[install] building Rust workspace (all binaries)...\n'
printf '[install] this may take 10-30 minutes on first build.\n\n'

cd "$REPO_DIR/admin/rust"
cargo build --release --workspace

# ── Build frontend ───────────────────────────────────────────────────────────

printf '\n[install] building frontend...\n'

cd "$REPO_DIR/admin/frontend"
npm ci --loglevel=error
npm run build

# ── Codesign (macOS only) ────────────────────────────────────────────────────

if [ "$OS_ID" = "macos" ]; then
    VMRUNNER="$REPO_DIR/admin/rust/target/release/vmrunner_macos_ipc"
    ENTITLEMENTS="$REPO_DIR/scripts/entitlements/vmrunner-macos.entitlements"
    if [ -f "$VMRUNNER" ] && [ -f "$ENTITLEMENTS" ]; then
        printf '[install] codesigning vmrunner_macos_ipc with VZ entitlement...\n'
        codesign --force --entitlements "$ENTITLEMENTS" -s - "$VMRUNNER"
    fi
fi

# ── Install soyeht to PATH ──────────────────────────────────────────────────

mkdir -p "$HOME/.local/bin"
ln -sf "$REPO_DIR/admin/rust/target/release/soyeht" "$HOME/.local/bin/soyeht"

if [ "$OS_ID" = "macos" ]; then
    ln -sf "$REPO_DIR/admin/rust/target/release/theyos" "$HOME/.local/bin/theyos"
    ln -sf "$REPO_DIR/admin/rust/target/release/init_macos_guest" "$HOME/.local/bin/init_macos_guest"
fi

# Check PATH
case ":$PATH:" in
    *":$HOME/.local/bin:"*)
        printf '[install] soyeht installed to ~/.local/bin/ (already in PATH)\n'
        ;;
    *)
        printf '\n[install] soyeht installed to ~/.local/bin/\n'
        if [ "$OS_ID" = "macos" ]; then
            printf '[install] Add to PATH: echo '\''export PATH="$HOME/.local/bin:$PATH"'\'' >> ~/.zshrc\n'
        else
            printf '[install] Add to PATH: echo '\''export PATH="$HOME/.local/bin:$PATH"'\'' >> ~/.bashrc\n'
        fi
        printf '[install] Then restart your terminal or run: export PATH="$HOME/.local/bin:$PATH"\n'
        # Also export for the current session so soyeht setup works
        export PATH="$HOME/.local/bin:$PATH"
        ;;
esac

# ── Run setup wizard ─────────────────────────────────────────────────────────

printf '\n[install] running setup wizard...\n\n'
exec "$REPO_DIR/admin/rust/target/release/soyeht" setup
