  {
    "id": "ensure_container_adds_and_lists_sorted",
    "description": "EnsureContainer adds containers that appear sorted in ListContainers, each with boot lines in default session",
    "operation": "ensure_and_list",
    "setup": [],
    "input": {
      "containers": ["zeta", "alpha", "mid"]
    },
    "expected": {
      "list": ["alpha", "mid", "zeta"],
