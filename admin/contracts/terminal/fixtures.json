  {
    "id": "run_command_success_appends_output_and_prompt",
    "description": "RunCommand with successful exec appends command echo, output lines, and prompt",
    "operation": "run_command_with_exec",
    "setup": [
      {"op": "ensure_container", "container": "box3"}
    ],
    "input": {
      "container": "box3",
      "session_id": "",
      "user": "admin",
      "command": "echo hello",
      "mock_output": "hello",
      "mock_exit_code": 0
    },
    "expected": {
      "error": false,
      "history": [
        "[boot] terminal ready :: box3",
        "soyeht@local:~$ ",
        "admin@box3:~$ echo hello",
        "hello",
        "soyeht@local:~$ "
      ],
      "history_count": 5
    }
  },
  {
    "id": "run_command_nonzero_adds_exit_line",
    "description": "RunCommand with non-zero exit code appends [exit N] line before prompt",
    "operation": "run_command_with_exec",
    "setup": [
      {"op": "ensure_container", "container": "box4"}
    ],
    "input": {
      "container": "box4",
      "session_id": "",
      "user": "admin",
      "command": "false",
      "mock_output": "error occurred",
      "mock_exit_code": 1
    },
    "expected": {
      "error": false,
      "history": [
        "[boot] terminal ready :: box4",
        "soyeht@local:~$ ",
        "admin@box4:~$ false",
        "error occurred",
        "[exit 1]",
        "soyeht@local:~$ "
      ],
      "history_count": 6
    }
  },
