  "format": {
    "byte_strings": "All protocol byte fields inside canonical CBOR are bstr. JSON represents fixture bytes as lowercase even-length hexadecimal without a 0x prefix.",
    "canonical_cbor": "RFC 8949 section 4.2.1 deterministic encoding. Every listed canonical CBOR hex value must decode, re-encode, and compare byte-for-byte before use.",
    "file_encoding": "UTF-8 JSON. Consumers compare the complete file byte-for-byte and pin the raw SHA-256 externally; they do not reserialize JSON.",
    "record_envelope": "Every post-Finished WebSocket message is canonical-CBOR([1, ciphertext]); direction, sequence, channel context, and authority never appear outside ciphertext."
  },
