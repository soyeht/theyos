  "contract": "soyeht-owner-mesh-rendezvous-corpus",
  "format": {
    "byte_strings": "All protocol byte fields are CBOR bstr. JSON writes bytes as lowercase even-length hexadecimal without a 0x prefix.",
    "canonical_cbor": "RFC 8949 section 4.2.1 deterministic encoding via household_rs::cbor::to_canonical_vec. Map keys are ordered by the bytewise lexicographic order of their canonical CBOR encodings; for these distinct-length tstr keys this is length-first.",
    "file_encoding": "UTF-8 JSON with two-space indentation and one trailing newline. Consumers compare complete raw file bytes and pin SHA-256 externally; they do not reserialize JSON.",
    "map_key_orders": {
      "candidate_lan_or_reflexive": [
        "ip",
        "port",
        "class"
      ],
      "candidate_relay": [
        "class",
        "signed_offer",
        "relay_endpoint"
      ],
      "close_or_ok": [
        "kind",
        "domain",
        "version",
        "rendezvous_id"
      ],
      "hello": [
        "kind",
        "domain",
        "version",
        "candidates",
        "rendezvous_id"
      ],
      "peer": [
        "kind",
        "domain",
        "version",
        "rendezvous_id",
        "peer_candidates",
        "observed_reflexive"
      ],
      "relay_endpoint": [
        "ip",
        "port"
      ]
    }
  },
