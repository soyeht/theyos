{
  "about": [
    "Canonical synthetic owner-mesh rendezvous corpus. The exact UTF-8 JSON file is pinned externally by raw SHA-256 after independent acceptance.",
    "This corpus is data-only, synthetic, and non-authoritative. It grants no production authority and installs no consumer, route, listener, provider, transport, dial, relay, or datapath effect.",
    "v1 is immutable after acceptance. Any byte or formatting change requires a new version, raw SHA-256, and review."
  ],
  "authority_status": "synthetic-test-only-non-authoritative",
  "behavioral_only": {
    "declared_without_byte_vectors": [
      {
        "id": "err.candidate_class_denied",
        "reason": "Policy depends on whether an otherwise well-shaped candidate class or endpoint is allowed."
      },
      {
        "id": "err.rendezvous_id_consumed",
        "reason": "Requires server state proving the identifier was already consumed."
      },
      {
        "id": "err.unknown_rendezvous_id",
        "reason": "Requires server state proving the identifier was never emitted."
      },
      {
        "id": "err.close_unauthorized",
        "reason": "Requires transport-session binding state for teardown authorization."
      },
      {
        "id": "err.pairing_full",
        "reason": "Requires two pairing slots already bound to other transport sessions."
      },
      {
        "id": "err.budget_exhausted",
        "reason": "Requires accumulated per-session attempt state."
      },
      {
        "id": "err.authority_revoked",
        "reason": "Requires a revoke or authority-generation fence during an active session."
      }
    ],
